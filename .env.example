# ===== U-Shop email (Resend) =====
# Get a free API key at https://resend.com (Dashboard → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where order emails should arrive (your inbox)
ORDER_TO_EMAIL=you@example.com

# The "from" address. For quick testing you can use Resend's shared
# sandbox sender below. For production use an address on a domain you
# have verified in Resend (e.g. "U-Shop <shop@yourdomain.com>").
ORDER_FROM_EMAIL=U-Shop <onboarding@resend.dev>
